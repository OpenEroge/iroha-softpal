#!/usr/bin/env bash
# Refuse to commit private game content or large binaries.
set -euo pipefail
fail=0
while IFS= read -r -d '' path; do
  case "$path" in
    iroha_game/*|work/*)
      echo "pre-commit: refusing private/work path: $path" >&2; fail=1; continue ;;
  esac
  lower=$(printf %s "$path" | tr "[:upper:]" "[:lower:]")
  case "$lower" in
    *.pac|*.exe|*.dll|*.mai|*.rar|*.pgd|*.dat|*.ogg|*.wav|*.mpg|*.wmv)
      echo "pre-commit: refusing game-like binary: $path" >&2; fail=1; continue ;;
  esac
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if (( size > 5242880 )); then
    echo "pre-commit: refusing file >5MB: $path ($size bytes)" >&2; fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if (( fail )); then
  echo "pre-commit: iroha_game content must never enter git (see CLAUDE.md)." >&2
  exit 1
fi
